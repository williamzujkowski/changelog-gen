{
  "name": "changelog-gen",
  "version": "1.0.0",
  "description": "Generate categorized changelogs from git history with optional AI summarization via nexus-agents",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "changelog-gen": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["changelog", "git", "conventional-commits", "nexus-agents"],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "tsx": "^4.19.0"
  }
}
